# Python bytecode (rebuilt automatically)
__pycache__/
*.pyc

# W&B local run logs (everything is on the W&B server)
wandb/

# review notes (local only)
report/REVIEW.md
report/HANDOFF.md

# overnight run logs and result backups
logs/
*.bak-*

# PDFs and the report's LaTeX sources (local only)
*.pdf
report/*.tex
